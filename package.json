{
  "name": "dumpling-theme",
  "type": "module",
  "version": "1.0.0",
  "description": "A beautiful, feature-rich blog theme for Astro. Built with Svelte 5, Tailwind CSS v4, and GSAP.",
  "homepage": "https://github.com/yourusername/dumpling-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/dumpling-theme"
  },
  "bugs": {
    "url": "https://github.com/yourusername/dumpling-theme/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "blog-theme",
    "svelte",
    "tailwindcss",
    "personal-blog",
    "portfolio",
    "markdown",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Your Name",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "node scripts/generate-icons/index.js && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post/index.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm",
    "icons": "node scripts/generate-icons/index.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fancyapps/ui": "^6.1.10",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource/roboto": "^5.2.9",
    "@iconify-json/fa7-brands": "^1.2.2",
    "@iconify-json/fa7-regular": "^1.2.3",
    "@iconify-json/fa7-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.55",
    "@iconify-json/simple-icons": "^1.2.70",
    "@iconify/utils": "^3.1.0",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/three": "^0.184.1",
    "@vfx-js/core": "^1.1.0",
    "@waline/api": "^1.1.2",
    "@waline/client": "^3.16.0",
    "astro": "7.3.5",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.2.0",
    "dayjs": "^1.11.19",
    "exifr": "^7.1.3",
    "expressive-code-collapsible": "^0.1.0",
    "expressive-code-language-badge": "^1.1.0",
    "glob": "^11.1.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "hastscript": "^9.0.1",
    "katex": "^0.18.9",
    "lucide-svelte": "0.469.0",
    "marked": "^16.4.2",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^7.0.2",
    "overlayscrollbars": "^2.14.0",
    "pagefind": "^1.4.0",
    "photoswipe": "^5.4.4",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.1.2",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.0",
    "satori": "^0.33.5",
    "satteri": "^0.10.5",
    "sharp": "^0.35.4",
    "stylus": "^0.64.0",
    "svelte": "^5.57.1",
    "three": "^0.186.1",
    "typescript": "^5.9.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "2.5.14",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/types": "^2.0.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "js-yaml": "^5.4.2",
    "postcss-import": "^16.2.0",
    "postcss-nesting": "^13.0.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4"
  },
  "packageManager": "pnpm@9.14.4"
}
